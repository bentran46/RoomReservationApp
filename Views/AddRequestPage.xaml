<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="RoomReservationApp.Views.AddRequestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Add Request">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Add Reservation Request"
                Style="{StaticResource PageTitleStyle}" 
                 />

            <Image
                x:Name="RoomImage"
                HeightRequest="200"
                Aspect="AspectFit" />

            <Label
                x:Name="RoomNumberLabel"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                x:Name="RoomDetailsLabel"
                FontSize="16" />

            <Entry
                x:Name="RequestedByEntry"
                Placeholder="Your name"
                Style="{StaticResource AssignmentEntryStyle}"/>

            <Entry
                x:Name="DescriptionEntry"
                Placeholder="Meeting purpose" 
                Keyboard="Numeric"
                Style="{StaticResource AssignmentEntryStyle}"/>

            <Label Text="Meeting Date" />

            <DatePicker
                x:Name="MeetingDatePicker" />

            <Label Text="Start Time" />

            <TimePicker
                x:Name="StartTimePicker" />

            <Label Text="End Time" />

            <TimePicker
                x:Name="EndTimePicker" />

            <Entry
                x:Name="ParticipantCountEntry"
                Placeholder="Number of participants"
                Keyboard="Numeric" />

            <Button
                Text="Add Request"
                Style="{StaticResource PrimaryButtonStyle}"
                Clicked="OnAddRequestClicked" />

            <Button
                Text="Back to Rooms"
                Style="{StaticResource PrimaryButtonStyle}"
                Clicked="OnBackToRoomsClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>