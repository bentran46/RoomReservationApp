<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="RoomReservationApp.Views.PickRoomPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RoomReservationApp.Models"
    Title="Meeting Rooms">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*,Auto,Auto,Auto,Auto"
        RowSpacing="12">

        <Label
            Grid.Row="0"
            Text="Meeting Rooms"
            Style="{StaticResource PageTitleStyle}" />

        <CollectionView
            x:Name="RoomsCollectionView"
            Grid.Row="1"
            ItemsSource="{Binding MeetingRooms}"
            SelectionMode="Single"
            SelectionChanged="OnRoomSelectionChanged">

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:MeetingRoom">

                    <Border Style="{StaticResource RoomCardStyle}">

                        <Grid
                            ColumnDefinitions="60,*"
                            ColumnSpacing="15">

                            <Image
                                Grid.Column="0"
                                Source="{Binding RoomTypeIcon}"
                                WidthRequest="50"
                                HeightRequest="50"
                                Aspect="AspectFit" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding RoomNumber}"
                                    FontAttributes="Bold"
                                    FontSize="18" />

                                <Label
                                    Text="{Binding SeatingCapacity,
                                    StringFormat='Capacity: {0}'}" />

                                <Label
                                    Text="{Binding RoomLayoutType}" />

                            </VerticalStackLayout>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Image
            x:Name="SelectedRoomImage"
            Grid.Row="2"
            HeightRequest="200"
            Aspect="AspectFit" />

        <Label
            x:Name="SelectedRoomLabel"
            Grid.Row="3"
            Text="Select a meeting room"
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            x:Name="SelectedRoomDetailsLabel"
            Grid.Row="4"
            Text="Room details will appear here."
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <HorizontalStackLayout
            Grid.Row="5"
            HorizontalOptions="Center"
            Spacing="15">

            <Button
                x:Name="AddRequestButton"
                Text="Add Request"
                IsEnabled="False"
                Style="{StaticResource PrimaryButtonStyle}"
                Clicked="OnAddRequestClicked" />

            <Button
                x:Name="ViewRequestsButton"
                Text="View Requests"
                IsEnabled="False"
                Style="{StaticResource PrimaryButtonStyle}"
                Clicked="OnViewRequestsClicked" />

        </HorizontalStackLayout>

    </Grid>

</ContentPage>