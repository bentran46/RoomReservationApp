<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="RoomReservationApp.Views.PickRoomPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RoomReservationApp.Models"
    Title="Meeting Rooms">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            Text="Meeting Rooms"
            
            Style="{StaticResource PageTitleStyle}" />

        <CollectionView
            x:Name="RoomsCollectionView"
            ItemsSource="{Binding MeetingRooms}"
            SelectionMode="Single"
            SelectionChanged="OnRoomSelectionChanged">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MeetingRoom">
                    <Border Style="{StaticResource RoomCardStyle}">
                        <HorizontalStackLayout Spacing="15">

                            <Image
                                Source="{Binding RoomTypeIcon}"
                                WidthRequest="50"
                                HeightRequest="50" />

                            <VerticalStackLayout>
                                <Label
                                    Text="{Binding RoomNumber}"
                                    FontAttributes="Bold"
                                    FontSize="18" />

                                <Label
                                    Text="{Binding SeatingCapacity, StringFormat='Capacity: {0}'}" />

                                <Label
                                    Text="{Binding RoomLayoutType}" />
                            </VerticalStackLayout>

                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Image
            x:Name="SelectedRoomImage"
            HeightRequest="200"
            Aspect="AspectFit"
            Source="dotnet_bot.png" />

        <Label
            x:Name="SelectedRoomLabel"
            Text="Select a meeting room"
            FontSize="20"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            x:Name="SelectedRoomDetailsLabel"
            Text="Room details will appear here."
            HorizontalOptions="Center" />

        <Button
            x:Name="AddRequestButton"
            Text="Add Request"
            IsEnabled="False"
            Style="{StaticResource PrimaryButtonStyle}"
            Clicked="OnAddRequestClicked" />

        <Button
            x:Name="ViewRequestsButton"
            Text="View Requests"
            IsEnabled="False"
            Style="{StaticResource PrimaryButtonStyle}"
            Clicked="OnViewRequestsClicked" />

    </VerticalStackLayout>

</ContentPage>